{
  "name": "StuSync",
  "dataColors": ["#185FA5", "#1D9E75", "#D85A30", "#7F77DD", "#BA7517", "#888780"],
  "background": "#FFFFFF",
  "foreground": "#2C2C2A",
  "tableAccent": "#185FA5",
  "good": "#1D9E75",
  "neutral": "#BA7517",
  "bad": "#D85A30",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#2C2C2A" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F5E5A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#2C2C2A" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E2DA" } }, "radius": 8 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F3EF" } }, "transparency": 0 }]
      }
    }
  }
}
